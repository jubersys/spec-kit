# ===========================================
# SONARQUBE / SONARCLOUD
# ===========================================
# Set to 'true' to enable SonarQube quality gate loop during implementation
SONAR_ENABLED=false

# Required: Authentication token
# Get from: SonarQube > My Account > Security > Generate Token
# SonarCloud: https://sonarcloud.io/account/security/
SONAR_TOKEN=

# Required: SonarQube server URL or Project Key
# SonarQube: https://your-sonarqube-server.com
# SonarCloud: https://sonarcloud.io
SONAR_HOST_URL=

# Optional: Project key (auto-detected from sonar-project.properties if not set)
# SONAR_PROJECT_KEY=

# Optional: Project display name
# SONAR_PROJECT_NAME=

# Optional: Organization key (required for SonarCloud)
# SONAR_ORGANIZATION=

# ===========================================
# OTHER SPECIFY ENVIRONMENT VARIABLES
# ===========================================

# GitHub token for extensions (git, taskstoissues, etc.)
# GITHUB_TOKEN=

# Feature directory numbering: sequential | timestamp
# SPECIFY_FEATURE_NUMBERING=sequential

# Script type for commands: sh | ps | py
# SPECIFY_SCRIPT_TYPE=py

# Custom integration executable paths (if not in PATH)
# SPECKIT_INTEGRATION_CLAUDE_EXECUTABLE=
# SPECKIT_INTEGRATION_GEMINI_EXECUTABLE=

# Extra args for integration CLIs
# SPECKIT_INTEGRATION_CLAUDE_EXTRA_ARGS=